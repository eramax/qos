# Optimized x86_64 kernel config for minimal server distro
# Target: <8MB bzImage, multicore optimized, microkernel-like

# ============================================================
# Architecture & Boot
# ============================================================
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_X86_X2APIC=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y

# UEFI boot (required)
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_EFI_VARS=y
CONFIG_EFI_RUNTIME_MAP=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_SYSFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FB_EFI=y

# Initramfs support
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
CONFIG_RD_GZIP=y

# ============================================================
# Executable Formats & Modules
# ============================================================
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_ARCH_MMAP_RND_BITS=28
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y

# Loadable modules (microkernel-like: load on demand)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y

# ============================================================
# Memory Management
# ============================================================
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_CMA=y
CONFIG_ZSMALLOC=y
CONFIG_ZPOOL=y

# ============================================================
# Core Filesystems (built-in for boot)
# ============================================================
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_MSDOS_FS=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SHMEM=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y

# ============================================================
# Cgroups v2 (resource isolation)
# ============================================================
CONFIG_CGROUPS=y
CONFIG_CGROUP2=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_BPF=y

# ============================================================
# Namespaces (container isolation)
# ============================================================
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_MOUNT_NS
CONFIG_USER_NS=y
CONFIG_TIME_NS=y

# ============================================================
# IPC & Async I/O
# ============================================================
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_IO_URING=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_AIO=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_MEMFD_CREATE=y
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=y

# ============================================================
# Networking Core
# ============================================================
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK=y
CONFIG_NETLINK_DIAG=y
CONFIG_UNIX_SCM=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_INET_AH=n
CONFIG_INET_ESP=n
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# nftables (host firewall)
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_TABLES=y
CONFIG_NFT_COMPAT=n
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y

# TCP optimizations
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_PFIFO_FAST=y

# ============================================================
# Network Devices (built-in: virtio for QEMU)
# ============================================================
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y

# QEMU virtio (built-in for boot)
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=m
CONFIG_VIRTIO_MMIO=m
CONFIG_VIRTIO_PCI_LEGACY=y

# Real hardware drivers (as modules for microkernel-like design)
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IXGBE=m
CONFIG_IGB=m
CONFIG_IGB_HWMON=y
CONFIG_R8169=m
CONFIG_BNX2X=m
CONFIG_TIGON3=m

# ============================================================
# Storage (virtio built-in, real hardware as modules)
# ============================================================
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_SCSI_VIRTIO=y

# Real hardware storage (modules)
CONFIG_AHCI=m
CONFIG_LIBATA=y
CONFIG_ATA_ACPI=y
CONFIG_SATA_AHCI=m
CONFIG_NVME_CORE=m
CONFIG_BLK_DEV_NVME=m

# ============================================================
# Serial Console
# ============================================================
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_DEPRECATED_OPTIONS=n
CONFIG_SERIAL_8250_PNP=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=32
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# ============================================================
# Scheduler (high-performance multicore)
# ============================================================
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_CLUSTER=y
CONFIG_NUMA=y
CONFIG_NUMA_BALANCING=y
CONFIG_X86_64_ACPI_NUMA=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_SCHED_CORE=n
CONFIG_SCHED_AUTOGROUP=n
CONFIG_HZ_250=y
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ_FULL=n
CONFIG_CFS_BANDWIDTH=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=5

# RCU optimizations for multicore
CONFIG_TREE_RCU=y
CONFIG_RCU_EXPERT=y
CONFIG_RCU_FANOUT=64
CONFIG_RCU_FANOUT_LEAF=16
CONFIG_RCU_BOOST=y
CONFIG_RCU_NOCB_CPU=y

# ============================================================
# Interrupt Handling
# ============================================================
CONFIG_IRQ_FORCED_THREADING=y
CONFIG_GENERIC_IRQ_PROBE=y
CONFIG_AUTO_IRQ_AFFINITY=y

# ============================================================
# Security & Capabilities
# ============================================================
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_AUDIT_WATCH=y
CONFIG_AUDIT_TREE=y

# Stack protection
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_REFCOUNT_FULL=y

# ============================================================
# Cryptography (minimal, for SSH/TLS)
# ============================================================
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_RSA=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_ECDSA=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_AKCIPHER=y
CONFIG_CRYPTO_RSA=y
CONFIG_CRYPTO_SIG=y
CONFIG_CRYPTO_ECDSA=y
CONFIG_CRYPTO_KPP=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_MANAGER=y
CONFIG_CRYPTO_NULL2=y

# Compression
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_DEFLATE=y

# ============================================================
# ZRAM (compressed swap)
# ============================================================
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MEMORY_TRACKING=y

# ============================================================
# PCI
# ============================================================
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_ATS=y
CONFIG_PCI_PRI=y
CONFIG_PCI_PASID=y

# ============================================================
# ACPI (hardware discovery)
# ============================================================
CONFIG_ACPI=y
CONFIG_ACPI_PCI=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_NUMA=y
CONFIG_PCCP=y

# ============================================================
# CPU Frequency Scaling (power management)
# ============================================================
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=m

# ============================================================
# I/O Schedulers
# ============================================================
CONFIG_MQ_DEFAULT=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_IOSCHED_BFQ=y
CONFIG_IOSCHED_NONE=y
CONFIG_DEFAULT_BFQ=y
CONFIG_DEFAULT_IOSCHED="bfq"

# ============================================================
# RTC (real-time clock for hardware)
# ============================================================
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_DRV_EFI=y

# ============================================================
# Hardware Monitoring (modules)
CONFIG_HWMON=m
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m

# ============================================================
# Watchdog (for server reliability)
# ============================================================
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_SOFT_WATCHDOG=y

# ============================================================
# Explicitly DISABLE unnecessary features
# ============================================================

# No sound
CONFIG_SOUND=n
CONFIG_SND=n

# No USB (modules only if needed for real hardware)
CONFIG_USB=n

# No wireless
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n

# No Bluetooth
CONFIG_BT=n

# No graphics (server only, no framebuffer except EFI)
CONFIG_DRM=n
CONFIG_VGA_CONSOLE=n
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=n

# No debugging
CONFIG_DEBUG_KERNEL=n
CONFIG_FTRACE=n
CONFIG_KALLSYMS=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_STACK_VALIDATION=n
CONFIG_UNWINDER_ORC=n
CONFIG_KASAN=n
CONFIG_LOCKDEP=n
CONFIG_DEBUG_SPINLOCK=n
CONFIG_DEBUG_MUTEXES=n

# No wireless drivers
CONFIG_ATH_COMMON=n
CONFIG_ATH9K_HW=n
CONFIG_ATH9K_COMMON=n
CONFIG_IWLWIFI=n
CONFIG_RTLWIFI=n

# No SCSI tape
CONFIG_CHR_DEV_ST=n

# No parallel ports
CONFIG_PARPORT=n

# No Apple-specific
CONFIG_APPLE_GMUX=n
CONFIG_APPLE_SPI=n

# No Staging drivers
CONFIG_STAGING=n

# No firewire
CONFIG_FIREWIRE=n

# No InfiniBand
CONFIG_INFINIBAND=n

# No NFC
CONFIG_NFC=n
