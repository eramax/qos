#!/bin/sh
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin

# Find the first non-loopback interface.
iface=""
for candidate in /sys/class/net/*; do
  [ -e "$candidate" ] || continue
  name="${candidate##*/}"
  [ "$name" = lo ] && continue
  iface="$name"
  break
done
[ -n "$iface" ] || { echo "networking: no interface found" >&2; exit 1; }

/bin/busybox ip link set dev "$iface" up

# Wait up to 5 s for the virtio-net carrier to assert before starting DHCP.
i=0
while [ "$i" -lt 5 ]; do
  carrier=$(cat "/sys/class/net/$iface/carrier" 2>/dev/null || echo 0)
  [ "$carrier" = "1" ] && break
  sleep 1
  i=$((i + 1))
done

# -T 5: wait 5 s per discover; -t 10: 10 retries before backing off
exec /bin/busybox udhcpc -i "$iface" -f -T 5 -t 10
