#!/bin/sh
# k3s-server — single-node k3s control plane + agent.
#
# The service definition lives under /usr/share/qos/s6/k3s-server until
# `qos cluster enable` copies it into /etc/s6/service-tree, at which
# point s6 starts supervising it.

set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin:/opt/cni/bin

state_dir="/var/lib/rancher/k3s"

mkdir -p "$state_dir"

# Wait for network (seed-reader may still be configuring interfaces).
# Busybox `ip` doesn't support "default" keyword; use route instead.
for _i in $(seq 1 30); do
    route -n 2>/dev/null | grep -q '^0\.0\.0\.0' && break
    sleep 2
done

# Download official k3s if not present.
if [ -x /usr/libexec/qos-install-k3s ]; then
    /usr/libexec/qos-install-k3s || {
        echo "k3s-server: failed to install k3s" >&2
        exec sleep 2147483647
    }
fi

if ! command -v k3s >/dev/null 2>&1; then
    echo "k3s-server: k3s binary not found" >&2
    exec sleep 2147483647
fi

# Alpine iptables uses nftables backend by default, but kube-proxy
# and flannel need the legacy iptables binary.
if command -v iptables-legacy >/dev/null 2>&1; then
    for _cmd in iptables iptables-restore iptables-save ip6tables ip6tables-restore ip6tables-save; do
        [ -x "/usr/sbin/${_cmd}-legacy" ] || continue
        ln -sf "/usr/sbin/${_cmd}-legacy" "/usr/sbin/${_cmd}" 2>/dev/null || true
    done
fi

# CNI plugins under /usr/libexec/cni on Alpine.  k3s may look under
# /opt/cni/bin or under $data_dir/data/cni; populate both.
mkdir -p /opt/cni
ln -sf /usr/libexec/cni /opt/cni/bin 2>/dev/null || true
mkdir -p "$state_dir/data/cni"
cp -a /usr/libexec/cni/* "$state_dir/data/cni/" 2>/dev/null || true

# Start k3s with advertise-address 127.0.0.1 for pod-to-pod communication.
# Internal pods reach API via localhost; external access patched below to use node IP.
exec k3s server \
    --data-dir "$state_dir" \
    --advertise-address 127.0.0.1 \
    --write-kubeconfig-mode=0644 \
    --snapshotter native \
    --disable servicelb \
    ${K3S_EXTRA_ARGS:-} &

_k3s_pid=$!

# Wait for kubeconfig, then patch for external access with actual node IP
for _i in $(seq 1 60); do
    [ -f /etc/rancher/k3s/k3s.yaml ] && break
    sleep 1
done

if [ -f /etc/rancher/k3s/k3s.yaml ]; then
    # Get the node's primary IP (src field from ip route get 1)
    _node_ip="$(ip route get 1 | grep -o 'src [^ ]*' | awk '{print $2}')"
    [ -n "$_node_ip" ] && [ "$_node_ip" != "127.0.0.1" ] && \
        sed -i 's|127\.0\.0\.1:6443|'${_node_ip}':6443|g' /etc/rancher/k3s/k3s.yaml 2>/dev/null || true
fi

wait $_k3s_pid
