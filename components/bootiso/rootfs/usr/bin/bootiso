#!/bin/sh
# bootiso - Boot an ISO image via kexec without rebooting through firmware
set -eu
export PATH=/usr/sbin:/sbin:/usr/bin:/bin

usage() {
    cat <<EOF
Usage: bootiso <img.iso>

Boot a live ISO image using kexec. The ISO is mounted, its kernel and
initrd are loaded into memory, and execution is handed off immediately.
On normal shutdown of the ISO session, Limine resumes from the hard disk.

Requirements: root, CONFIG_KEXEC=y, live bootable ISO with vmlinuz + initrd
EOF
}

[ "$(id -u)" = "0" ] || { echo "bootiso: must run as root" >&2; exit 1; }

ISO=""
for _arg in "$@"; do
    case "$_arg" in
        --help|-h) usage; exit 0 ;;
        -*) echo "bootiso: unknown option: $_arg" >&2; exit 1 ;;
        *) ISO="$_arg" ;;
    esac
done

[ -n "$ISO" ] || { usage >&2; exit 1; }
[ -f "$ISO" ] || { echo "bootiso: file not found: $ISO" >&2; exit 1; }

for _cmd in kexec mount umount cpio mktemp lz4; do
    command -v "$_cmd" >/dev/null 2>&1 || { echo "bootiso: required tool missing: $_cmd" >&2; exit 1; }
done

BOOTISO_CMDLINE_EXTRA="${BOOTISO_CMDLINE_EXTRA:-}"

MNT="/tmp/bootiso-$$"
WORK="/tmp/bootiso-work-$$"
mkdir -p "$MNT"
mkdir -p "$WORK"

_cleanup() {
    umount "$MNT" 2>/dev/null || true
    rm -rf "$WORK" 2>/dev/null || true
    rmdir "$MNT" 2>/dev/null || true
}
trap _cleanup EXIT INT TERM

echo "bootiso: mounting $ISO ..."
mount -o loop,ro "$ISO" "$MNT"

# Locate kernel — try common ISO layout paths
VMLINUZ=""
INITRD=""
for _k in vmlinuz boot/vmlinuz live/vmlinuz casper/vmlinuz; do
    [ -f "$MNT/$_k" ] && VMLINUZ="$MNT/$_k" && break
done
for _i in initramfs-live.img initrd.img boot/initrd.img live/initrd.img casper/initrd.lz casper/initrd; do
    [ -f "$MNT/$_i" ] && INITRD="$MNT/$_i" && break
done

[ -n "$VMLINUZ" ] || { echo "bootiso: cannot find vmlinuz in ISO" >&2; exit 1; }
[ -n "$INITRD"  ] || { echo "bootiso: cannot find initrd in ISO"  >&2; exit 1; }
[ -f "$MNT/rootfs.sfs" ] || { echo "bootiso: cannot find rootfs.sfs in ISO" >&2; exit 1; }

EMBEDDED_ROOTFS="$WORK/rootfs.sfs"
EXTRA_INITRD="$WORK/rootfs.cpio"
DECOMPRESSED_INITRD="$WORK/initramfs-raw.cpio"
COMBINED_INITRD="$WORK/initramfs-kexec.img"

cp "$MNT/rootfs.sfs" "$EMBEDDED_ROOTFS"
(
    cd "$WORK"
    printf '%s\n' rootfs.sfs | cpio -o -H newc > "$EXTRA_INITRD"
) || { echo "bootiso: failed to create rootfs cpio" >&2; exit 1; }

# Decompress the lz4-compressed initramfs from the ISO, then merge with rootfs.
# Concatenating a raw cpio to a compressed stream is unreliable — the kernel
# may not process the trailing chunk after lz4 decompression.
lz4 -d < "$INITRD" > "$DECOMPRESSED_INITRD" || {
    echo "bootiso: failed to decompress initramfs (missing lz4?)" >&2
    exit 1
}
cat "$DECOMPRESSED_INITRD" "$EXTRA_INITRD" > "$COMBINED_INITRD"

echo "bootiso: kernel  -> $VMLINUZ"
echo "bootiso: initrd  -> $INITRD + embedded rootfs.sfs"
echo "bootiso: loading kernel via kexec ..."

kexec -u 2>/dev/null || true

# Build cmdline: preserve console/earlycon/loglevel from current kernel,
# add boot=live, and append any extra args from the environment.
CMDLINE="boot=live"
for _arg in $(cat /proc/cmdline); do
    case "$_arg" in
        console=*|earlycon=*|loglevel=*|ignore_loglevel|net.ifnames=*|biosdevname=*|root=*|rootfstype=*|rootwait|ro|rw|init=*|quiet)
            CMDLINE="$CMDLINE $_arg"
            ;;
    esac
done
if [ -n "$BOOTISO_CMDLINE_EXTRA" ]; then
    CMDLINE="$CMDLINE $BOOTISO_CMDLINE_EXTRA"
fi

kexec -l "$VMLINUZ" --initrd="$COMBINED_INITRD" --command-line="$CMDLINE"

echo "bootiso: handing off to ISO kernel now ..."
kexec -e
