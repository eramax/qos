#!/usr/bin/env bash
# qos-ota - A/B slot OTA orchestration.
#
# Single source of truth for the four OTA phases. The legacy entry points
# builder/tools/ota-{prepare,switch,rollback,healthcheck}.sh are 1-line wrappers
# that re-exec this script with the right subcommand for back-compat with
# tests/test_ota_flow.sh.
#
# Subcommands all share OTA_STATE_DIR; prepare also needs OTA_SLOTS_FILE.

set -euo pipefail
IFS=$'\n\t'

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=/dev/null
source "$script_dir/lib/common.sh"

root="$(repo_root)"
state_dir="${OTA_STATE_DIR:-$root/build/ota}"
state_file="$state_dir/state.json"

require_state() {
    [[ -f "$state_file" ]] || die "missing OTA state file: $state_file"
    require_cmd jq
}

cmd_prepare() {
    local slots_file="${OTA_SLOTS_FILE:-$root/builder/pipeline/05-image/slots.json}"
    local image_path="${OTA_IMAGE:-${1:-}}"

    [[ -f "$slots_file" ]] || die "missing slot manifest: $slots_file"
    [[ -n "$image_path" ]] || die "usage: qos-ota prepare <image-path>"
    [[ -f "$image_path" && -s "$image_path" ]] || die "missing or empty image artifact: $image_path"
    require_cmd jq

    local active inactive fallback staged
    active="$(jq -r '.active' "$slots_file")"
    inactive="$(jq -r '.inactive' "$slots_file")"
    fallback="$(jq -r '.fallback' "$slots_file")"

    mkdir -p "$state_dir/staging/$inactive"
    staged="$state_dir/staging/$inactive/image.raw"
    cp "$image_path" "$staged"

    jq -n \
        --arg active_slot   "$active" \
        --arg previous_slot "$active" \
        --arg pending_slot  "$inactive" \
        --arg fallback_slot "$fallback" \
        --arg staged_image  "$staged" \
        '{active_slot:$active_slot, previous_slot:$previous_slot,
          pending_slot:$pending_slot, fallback_slot:$fallback_slot,
          staged_image:$staged_image, boot_verified:false}' \
        > "$state_file"

    echo "$staged"
}

# rewrite_active <new_active> <new_previous>
rewrite_active() {
    local new_active="$1" new_previous="$2"
    jq --arg active_slot "$new_active" \
       --arg previous_slot "$new_previous" \
       --argjson boot_verified false \
       '.active_slot = $active_slot
        | .previous_slot = $previous_slot
        | .pending_slot = null
        | .boot_verified = $boot_verified' \
       "$state_file" > "$state_file.tmp"
    mv "$state_file.tmp" "$state_file"
}

cmd_switch() {
    require_state
    local active pending
    active="$(jq -r '.active_slot' "$state_file")"
    pending="$(jq -r '.pending_slot' "$state_file")"
    [[ "$pending" != "null" && -n "$pending" ]] || die "no pending slot to switch to"
    rewrite_active "$pending" "$active"
    echo "$pending"
}

cmd_rollback() {
    require_state
    local current previous
    current="$(jq -r '.active_slot' "$state_file")"
    previous="$(jq -r '.previous_slot' "$state_file")"
    [[ "$previous" != "null" && -n "$previous" ]] || die "no previous slot to roll back to"
    rewrite_active "$previous" "$current"
    echo "$previous"
}

cmd_healthcheck() {
    require_state
    if [[ "${OTA_BOOT_OK:-1}" == "1" \
       && "${OTA_NETWORK_OK:-1}" == "1" \
       && "${OTA_SERVICE_OK:-1}" == "1" ]]; then
        jq '.boot_verified = true' "$state_file" > "$state_file.tmp"
        mv "$state_file.tmp" "$state_file"
        echo "ok"
        return 0
    fi

    if [[ "${OTA_AUTOROLLBACK:-0}" == "1" ]]; then
        cmd_rollback >/dev/null
    fi
    die "healthcheck failed"
}

usage() {
    cat <<EOF
Usage: qos-ota <subcommand> [args]

Subcommands:
  prepare <image>   Stage a new image into the inactive slot.
  switch            Activate the pending slot.
  rollback          Revert to the previous slot.
  healthcheck       Mark active slot verified, or roll back on failure.

Environment:
  OTA_STATE_DIR     State directory (default: build/ota/).
  OTA_SLOTS_FILE    Slot manifest (prepare only).
  OTA_BOOT_OK       Healthcheck input (default 1).
  OTA_NETWORK_OK    Healthcheck input (default 1).
  OTA_SERVICE_OK    Healthcheck input (default 1).
  OTA_AUTOROLLBACK  Roll back on healthcheck failure (default 0).
EOF
}

main() {
    local sub="${1:-}"
    [[ "$#" -gt 0 ]] && shift || true
    case "$sub" in
        prepare)     cmd_prepare "$@" ;;
        switch)      cmd_switch ;;
        rollback)    cmd_rollback ;;
        healthcheck) cmd_healthcheck ;;
        ''|help|-h|--help) usage ;;
        *) printf 'error: unknown subcommand: %s\n\n' "$sub" >&2; usage >&2; exit 2 ;;
    esac
}

main "$@"
