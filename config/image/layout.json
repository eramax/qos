{
  "boot_mode": "uefi",
  "disk_format": "raw",
  "partition_table": "gpt",
  "image_size": "1G",
  "partitions": [
    {
      "name": "efi",
      "filesystem": "vfat",
      "mount": "/boot/efi",
      "size": "64M"
    },
    {
      "name": "root-a",
      "filesystem": "ext4",
      "mount": "/",
      "slot": "A",
      "immutable": true,
      "size": "48M"
    },
    {
      "name": "root-b",
      "filesystem": "ext4",
      "mount": "/",
      "slot": "B",
      "immutable": true,
      "size": "48M"
    },
    {
      "name": "state",
      "filesystem": "ext4",
      "mount": "/var",
      "mutable": true,
      "size": "auto"
    }
  ]
}
