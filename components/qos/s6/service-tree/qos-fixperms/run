#!/bin/sh
set -eu

_n=0; while [ ! -e /dev/dri/card0 ] && [ "$_n" -lt 120 ]; do sleep 0.25; _n=$((_n+1)); done

chmod 666 /dev/null 2>/dev/null || true
chmod 666 /run/seatd.sock 2>/dev/null || true
chown root:video /dev/dri/card0 /dev/dri/renderD128 2>/dev/null || true
chmod 660 /dev/dri/card0 /dev/dri/renderD128 2>/dev/null || true

exec sleep 2147483647
