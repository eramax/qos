# Root is an overlayfs (set up by initramfs) backed by the immutable root
# partition and the writable state partition.  /var is bind-mounted from the
# state partition for persistent logs, apk cache, and slot state.
tmpfs /run tmpfs rw,nosuid,nodev,mode=0755 0 0
tmpfs /tmp tmpfs rw,nosuid,nodev,mode=1777 0 0
