#!/bin/sh
# qos-cluster-app — manage QOS cluster applications
# Usage: qos-cluster-app enable  [app]   — deploy app (default: cluster-info)
#        qos-cluster-app disable [app]   — remove app
#        qos-cluster-app list            — list available apps
#        qos-cluster-app status          — show deployed apps
set -eu

APP_DIR="/usr/share/qos/cluster-app"
CONF="/etc/qos/cluster-app.conf"

usage() {
    cat <<EOF
Usage: qos-cluster-app <command> [app]

Commands:
  enable  [app]   Deploy an app into the cluster (default: cluster-info)
  disable [app]   Remove an app from the cluster
  list            List available apps
  status          Show deployed cluster apps

Apps:
  cluster-info    K3s cluster dashboard

Configuration: $CONF
  Values not set in the config file or environment will be prompted interactively.
EOF
}

# ── load config ───────────────────────────────────────────────────────
# Use "${VAR-}" to preserve environment variable overrides
CLUSTER_INFO_HOST="${CLUSTER_INFO_HOST-}"
CF_DNS_API_TOKEN="${CF_DNS_API_TOKEN-}"
ACME_EMAIL="${ACME_EMAIL-}"
if [ -f "$CONF" ]; then
    . "$CONF" 2>/dev/null || true
fi

# ── helpers ───────────────────────────────────────────────────────────

die() { echo "error: $*" >&2; exit 1; }

require_conf() {
    local key="$1" val="$2"
    if [ -z "$val" ]; then
        die "$key is not set in $CONF — edit that file first"
    fi
}

prompt_if_empty() {
    local key="$1" val="$2" prompt="$3"
    if [ -z "$val" ]; then
        if [ -t 0 ]; then
            printf "%s: " "$prompt"
            read -r val
        else
            die "$key is required — set it via environment variable or in $CONF"
        fi
    fi
    printf '%s' "$val"
}

wait_kubectl() {
    local i=0
    while [ $i -lt 30 ]; do
        kubectl get nodes >/dev/null 2>&1 && return 0
        i=$((i+1)); sleep 2
    done
    die "kubectl not ready — is k3s running?"
}

# derive wildcard domain from host: info.sv3.example.com → *.sv3.example.com
wildcard_of() {
    echo "$1" | sed 's/^[^.]*\./\*./'
}

traefik_acme_patch() {
    local cf_token="$1" acme_email="$2" wildcard="$3"
    cat <<'PATCH' | sed -e "s|__CF_TOKEN__|${cf_token}|g" -e "s|__ACME_EMAIL__|${acme_email}|g" -e "s|__WILDCARD__|${wildcard}|g"
{
  "spec": {
    "template": {
      "spec": {
        "containers": [{
          "name": "traefik",
          "env": [{
            "name": "CF_DNS_API_TOKEN",
            "value": "__CF_TOKEN__"
          }],
          "args": [
            "--entryPoints.metrics.address=:9100/tcp",
            "--entryPoints.traefik.address=:8080/tcp",
            "--entryPoints.web.address=:8000/tcp",
            "--entryPoints.websecure.address=:8443/tcp",
            "--api.dashboard=true",
            "--ping=true",
            "--metrics.prometheus=true",
            "--metrics.prometheus.entrypoint=metrics",
            "--providers.kubernetescrd",
            "--providers.kubernetescrd.allowEmptyServices=true",
            "--providers.kubernetesingress",
            "--providers.kubernetesingress.allowEmptyServices=true",
            "--providers.kubernetesingress.ingressendpoint.publishedservice=kube-system/traefik",
            "--entryPoints.websecure.http.tls=true",
            "--certificatesresolvers.letsencrypt.acme.email=__ACME_EMAIL__",
            "--certificatesresolvers.letsencrypt.acme.storage=/data/acme.json",
            "--certificatesresolvers.letsencrypt.acme.dnschallenge=true",
            "--certificatesresolvers.letsencrypt.acme.dnschallenge.provider=cloudflare",
            "--certificatesresolvers.letsencrypt.acme.dnschallenge.resolvers=1.1.1.1:53,8.8.8.8:53",
            "--log.level=INFO"
          ]
        }]
      }
    }
  }
}
PATCH
}

# ── commands ──────────────────────────────────────────────────────────

cmd_enable() {
    APP="${1:-cluster-info}"
    case "$APP" in
        cluster-info)
            CLUSTER_INFO_HOST="$(prompt_if_empty CLUSTER_INFO_HOST "${CLUSTER_INFO_HOST:-}" "Cluster info hostname (e.g. info.example.com)")"
            [ -n "$CLUSTER_INFO_HOST" ] || die "CLUSTER_INFO_HOST is required"

            CF_DNS_API_TOKEN="$(prompt_if_empty CF_DNS_API_TOKEN "${CF_DNS_API_TOKEN:-}" "Cloudflare API token")"
            [ -n "$CF_DNS_API_TOKEN" ] || die "CF_DNS_API_TOKEN is required"

            ACME_EMAIL="${ACME_EMAIL:-admin@$(echo "$CLUSTER_INFO_HOST" | cut -d. -f2-)}"
            WILDCARD="$(wildcard_of "$CLUSTER_INFO_HOST")"

            wait_kubectl

            # 1. Traefik ACME (DNS-01 + wildcard cert)
            #    Directly patch the Traefik deployment — avoids HelmChartConfig bugs.
            echo "Configuring Traefik ACME (wildcard: ${WILDCARD})"
            PATCH_TMP="$(mktemp /tmp/traefik-acme-patch-XXXXXX)"
            trap 'rm -f "$PATCH_TMP" "$CI_TMP"' EXIT
            traefik_acme_patch "$CF_DNS_API_TOKEN" "$ACME_EMAIL" "$WILDCARD" > "$PATCH_TMP"
            kubectl patch deployment traefik -n kube-system --type=strategic --patch-file "$PATCH_TMP" || \
                die "failed to patch Traefik deployment"

            # 2. cluster-info ConfigMap (server.py)
            SCRIPT="$APP_DIR/server.py"
            [ -f "$SCRIPT" ] || die "$SCRIPT not found"
            echo "Deploying cluster-info → https://${CLUSTER_INFO_HOST}"
            kubectl create configmap cluster-info-script \
                --from-file=server.py="$SCRIPT" \
                --dry-run=client -o yaml | kubectl apply -f -

            # 3. cluster-info manifests (deployment, service, ingress, RBAC)
            MANIFEST="$APP_DIR/cluster-info.yaml"
            [ -f "$MANIFEST" ] || die "$MANIFEST not found"
            CI_TMP="$(mktemp /tmp/cluster-info-XXXXXX)"
            trap 'rm -f "$CI_TMP"' EXIT
            sed "s|CLUSTER_INFO_HOST|${CLUSTER_INFO_HOST}|g" "$MANIFEST" > "$CI_TMP"
            kubectl apply -f "$CI_TMP"

            echo ""
            echo "Done. App will be available at: https://${CLUSTER_INFO_HOST}"
            echo "Waiting for Traefik rollout with ACME config..."
            kubectl rollout status deployment traefik -n kube-system --timeout=60s 2>/dev/null || \
                echo "(rollout may still be in progress)"
            echo "Check status: qos-cluster-app status"
            ;;
        *)
            die "unknown app '$APP'"
            ;;
    esac
}

cmd_disable() {
    APP="${1:-cluster-info}"
    case "$APP" in
        cluster-info)
            wait_kubectl

            # Remove cluster-info resources
            MANIFEST="$APP_DIR/cluster-info.yaml"
            if [ -f "$MANIFEST" ]; then
                TMP="$(mktemp /tmp/cluster-info-XXXXXX)"
                trap 'rm -f "$TMP"' EXIT
                sed "s|CLUSTER_INFO_HOST|placeholder|g" "$MANIFEST" > "$TMP"
                kubectl delete -f "$TMP" --ignore-not-found
            fi
            kubectl delete configmap cluster-info-script --ignore-not-found

            echo "cluster-info removed"
            echo "Note: Traefik ACME config is not removed. To reset Traefik to defaults:"
            echo "  kubectl rollout restart deployment traefik -n kube-system"
            ;;
        *)
            die "unknown app '$APP'"
            ;;
    esac
}

cmd_list() {
    echo "Available apps:"
    for f in "$APP_DIR"/*.yaml; do
        [ -f "$f" ] || continue
        name="$(basename "$f" .yaml)"
        case "$name" in traefik-acme) continue;; esac
        echo "  $name"
    done
}

cmd_status() {
    wait_kubectl
    echo "=== Pods ==="
    kubectl get pods -n default -l app=cluster-info 2>/dev/null || true
    echo "=== Services ==="
    kubectl get service -n default cluster-info 2>/dev/null || true
    echo "=== Ingresses ==="
    kubectl get ingress -n default cluster-info 2>/dev/null || true
    echo "=== Traefik ACME ==="
    if kubectl get deployment traefik -n kube-system -o jsonpath='{.spec.template.spec.containers[0].args}' 2>/dev/null | grep -q letsencrypt; then
        echo "  configured (letsencrypt resolver found in deployment args)"
    else
        echo "  not configured"
    fi
}

# ── dispatch ──────────────────────────────────────────────────────────
case "${1:-help}" in
    enable)  shift; cmd_enable  "$@" ;;
    disable) shift; cmd_disable "$@" ;;
    list)    cmd_list ;;
    status)  cmd_status ;;
    help|--help|-h) usage ;;
    *) echo "Unknown command: $1"; usage; exit 1 ;;
esac
