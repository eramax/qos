#!/bin/sh
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin

state_dir="/run/qos"
local_done="$state_dir/cloud-init-local.done"
final_done="$state_dir/cloud-init.done"

mkdir -p "$state_dir"

if [ -f /etc/cloud-init.disabled ] || grep -q 'cloud-init=off' /proc/cmdline 2>/dev/null; then
    : > "$final_done"
    exit 0
fi

if ! command -v cloud-init >/dev/null 2>&1; then
    : > "$final_done"
    exit 0
fi

net_wait=0
while [ "$net_wait" -lt 30 ]; do
    if ip -4 route show default 2>/dev/null | grep -q .; then
        break
    fi
    sleep 1
    net_wait=$((net_wait + 1))
done

if ! cloud-init init; then
    echo "cloud-init: init stage failed" >&2
    : > "$final_done"
    exit 0
fi

# Apply static network config if cloud-init rendered one (VPS providers).
if [ -f /etc/network/interfaces ] && grep -q 'inet static' /etc/network/interfaces 2>/dev/null; then
    echo "cloud-init: applying static network configuration"
    /sbin/ifup -a || true
fi

if ! cloud-init modules --mode=config; then
    echo "cloud-init: config stage failed" >&2
    : > "$final_done"
    exit 0
fi

if ! cloud-init modules --mode=final; then
    echo "cloud-init: final stage failed" >&2
    : > "$final_done"
    exit 0
fi

: > "$final_done"
