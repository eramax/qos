#!/bin/sh
# k3s-server — single-node k3s control plane + agent.
#
# Staged on the `server` profile but OFF by default. Operator enables it
# by creating /etc/qos/k3s-enabled and restarting the service (or
# rebooting). See `qos cluster enable` (when wired).

set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin:/opt/cni/bin

enabled_marker="/etc/qos/k3s-enabled"
state_dir="/var/lib/rancher/k3s"

if [ ! -f "$enabled_marker" ]; then
    exec sleep 2147483647
fi

mkdir -p "$state_dir"

# Download official k3s if not present (Alpine package strips addons).
if [ -x /usr/libexec/qos-install-k3s ]; then
    /usr/libexec/qos-install-k3s || {
        echo "k3s-server: failed to install k3s" >&2
        exec sleep 2147483647
    }
fi

if ! command -v k3s >/dev/null 2>&1; then
    echo "k3s-server: k3s binary not found" >&2
    exec sleep 2147483647
fi

# Alpine iptables uses nftables backend by default, but kube-proxy
# and flannel need the legacy iptables binary.
if command -v iptables-legacy >/dev/null 2>&1; then
    for _cmd in iptables iptables-restore iptables-save ip6tables ip6tables-restore ip6tables-save; do
        [ -x "/usr/sbin/${_cmd}-legacy" ] || continue
        ln -sf "/usr/sbin/${_cmd}-legacy" "/usr/sbin/${_cmd}" 2>/dev/null || true
    done
fi

# CNI plugins under /usr/libexec/cni on Alpine.  k3s may look under
# /opt/cni/bin or under $data_dir/data/cni; populate both.
mkdir -p /opt/cni
ln -sf /usr/libexec/cni /opt/cni/bin 2>/dev/null || true
mkdir -p "$state_dir/data/cni"
cp -a /usr/libexec/cni/* "$state_dir/data/cni/" 2>/dev/null || true

exec k3s server \
    --data-dir "$state_dir" \
    --write-kubeconfig-mode=0644 \
    --snapshotter native \
    --disable servicelb \
    ${K3S_EXTRA_ARGS:-}
