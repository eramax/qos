# x86_64 kernel config fragment for the minimal server image.
# This is a seed fragment, not a full .config.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y

CONFIG_BINFMT_ELF=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_SHMEM=y

CONFIG_CGROUPS=y
CONFIG_CGROUP2=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_MOUNT_NS=y

CONFIG_IO_URING=y
CONFIG_FUTEX=y
CONFIG_UNIX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_MEMFD_CREATE=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZPOOL=y
CONFIG_CRYPTO_LZ4=y

CONFIG_PCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_CONSOLE=y

CONFIG_OVERLAY_FS=y

CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_NETLINK=y
CONFIG_NETLINK_ROUTE=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y

CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_SCHED_CORE=n
CONFIG_SCHED_AUTOGROUP=n
CONFIG_HZ_250=y
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ_FULL=n
CONFIG_UCLAMP_TASK=y

CONFIG_DEBUG_KERNEL=n
CONFIG_FTRACE=n
CONFIG_KALLSYMS=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_STACK_VALIDATION=n
CONFIG_UNWINDER_ORC=n
CONFIG_FRAME_POINTER=y
