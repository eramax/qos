#!/bin/sh
# QOS wrapper to translate OpenRC rc-service to s6 commands for cloud-init

if [ "$1" = "--nocolor" ]; then
    shift
fi

service="$1"
action="$2"

case "$service" in
    sshd) service="dropbear" ;;
    network) service="networking" ;;
esac

svc_dir="/run/service/$service"

if [ ! -d "$svc_dir" ]; then
    exit 0
fi

case "$service" in
    networking)
        # Never restart networking from cloud-init — the networking service
        # manages its own DHCP lifecycle (udhcpc).  A restart would kill the
        # active DHCP client and lose the lease.
        exit 0
        ;;
esac

case "$action" in
    start|restart)
        s6-svc -r "$svc_dir" || s6-svc -u "$svc_dir"
        ;;
    stop)
        s6-svc -d "$svc_dir"
        ;;
esac

exit 0
