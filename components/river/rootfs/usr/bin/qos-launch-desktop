#!/bin/sh
set -eu

chmod 666 /run/seatd.sock 2>/dev/null || true

LOG="/run/qos/river.log"
log() { printf '[qos-river] %s\n' "$*" >> "$LOG" 2>/dev/null; }

mkdir -p /run/qos 2>/dev/null || true

command -v river >/dev/null 2>&1 || { log "skip: river not found"; exit 0; }

retry_file="/run/qos/river-attempts"
max_attempts=3

attempts=0
[ -f "$retry_file" ] && attempts="$(cat "$retry_file" 2>/dev/null)" || true
attempts=$((attempts + 1))
printf '%d\n' "$attempts" > "$retry_file"
[ "$attempts" -le "$max_attempts" ] || { log "skip: $attempts attempts exceeded max $max_attempts"; exit 0; }

log "attempt $attempts/$max_attempts"

for _mod in vmwgfx virtio_gpu amdgpu radeon i915 nouveau vboxguest; do
  modprobe "$_mod" 2>/dev/null || true
done

log "waiting for /dev/dri/card0 ..."
_n=0; while [ ! -e /dev/dri/card0 ] && [ "$_n" -lt 60 ]; do sleep 0.25; _n=$((_n+1)); done
if [ ! -e /dev/dri/card0 ]; then
  log "FATAL: /dev/dri/card0 not found after 15s"
  exit 1
fi
log "/dev/dri/card0 found"

log "waiting for /dev/input/event0 ..."
_n=0; while [ ! -e /dev/input/event0 ] && [ "$_n" -lt 120 ]; do sleep 0.25; _n=$((_n+1)); done
if [ -e /dev/input/event0 ]; then
  log "/dev/input/event0 found"
  udevadm trigger --action=add --subsystem-match=input 2>/dev/null || true
  udevadm trigger --action=add --subsystem-match=sound 2>/dev/null || true
  udevadm settle 2>/dev/null || true
  sleep 0.5
else
  log "WARN: /dev/input/event0 not found after 30s"
  export WLR_LIBINPUT_NO_DEVICES=1
fi

# Set up emo's XDG runtime dir as root before switching users
mkdir -p /run/user/1000
chown 1000:1000 /run/user/1000
chmod 0700 /run/user/1000

amixer set Master 100% unmute 2>/dev/null || true
amixer set PCM 100% unmute 2>/dev/null || true

log "starting river as emo (renderer=pixman, seatd) ..."

export LANG=C.UTF-8
export CHARSET=UTF-8
export XDG_RUNTIME_DIR=/run/user/1000
export XDG_CONFIG_HOME=/home/emo/.config
export XDG_SESSION_TYPE=wayland
export XDG_VTNR=1
export LIBSEAT_BACKEND=seatd
export WLR_DRM_NO_MODIFIERS=1
export WLR_EGL_NO_MODIFIERS=1
export WLR_RENDERER=pixman
export HOME=/home/emo
export USER=emo

# Fix device permissions after udev settle so emo can use them
chmod 666 /dev/null /dev/random /dev/urandom /dev/ptmx 2>/dev/null || true
mount -o remount,ptmxmode=666 /dev/pts 2>/dev/null || true
# Give video group access to DRI devices (udevd sets root:root instead of root:video)
chgrp video /dev/dri/card0 /dev/dri/renderD128 2>/dev/null || true
# Give audio group access to sound devices for pipewire
chgrp audio /dev/snd/* 2>/dev/null || true
chmod g+rw /dev/snd/* 2>/dev/null || true

# Stop root pipewire so emo's instance can take over
pkill -f '^/usr/bin/pipewire' 2>/dev/null || true
pkill -f '^/usr/bin/pipewire-pulse' 2>/dev/null || true
pkill -f '^/usr/bin/wireplumber' 2>/dev/null || true
sleep 0.5

exec su -m emo -c 'pipewire & sleep 0.5 && wireplumber & pipewire-pulse & exec river' 2>>"$LOG"
