# Minimal x86_64 kernel config for QOS
# Target: <8MB bzImage
# Component-specific flags are in kernel/*.conf fragments within their components

# ============================================================
# Architecture & Boot
# ============================================================
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_X86_X2APIC=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y

# UEFI boot (required)
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_EFI_VARS=y
CONFIG_EFI_RUNTIME_MAP=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_SYSFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FB_EFI=y

# Initramfs support
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_RD_XZ=y
CONFIG_DECOMPRESS_LZ4=y
CONFIG_DECOMPRESS_ZSTD=y

# ============================================================
# Executable Formats & Modules
# ============================================================
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_ARCH_MMAP_RND_BITS=28
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y

# Loadable modules (microkernel-like: load on demand)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y

# ============================================================
# Memory Management
# ============================================================
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_CMA=y
CONFIG_ZSMALLOC=y
CONFIG_ZPOOL=y

# ============================================================
# Core Filesystems (built-in for boot)
# ============================================================
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_MSDOS_FS=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Live boot: squashfs rootfs mounted via loop device
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
CONFIG_OVERLAY_FS=y
CONFIG_NLS_ASCII=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SHMEM=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y

# Required for module symbol resolution
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=n

# QEMU virtio block device (required for boot in QEMU)
CONFIG_VIRTIO_BLK=y

# ============================================================
# Explicitly DISABLE unnecessary features
# ============================================================

# No sound (enabled via fragment if needed)
CONFIG_SOUND=n
CONFIG_SND=n

# No USB (enabled via fragment if needed)
CONFIG_USB=n

# No wireless
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n

# No Bluetooth
CONFIG_BT=n

# No debugging
CONFIG_DEBUG_KERNEL=n
CONFIG_FTRACE=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_STACK_VALIDATION=n
CONFIG_UNWINDER_ORC=n
CONFIG_KASAN=n
CONFIG_LOCKDEP=n
CONFIG_DEBUG_SPINLOCK=n
CONFIG_DEBUG_MUTEXES=n

# No wireless drivers
CONFIG_ATH_COMMON=n
CONFIG_ATH9K_HW=n
CONFIG_ATH9K_COMMON=n
CONFIG_IWLWIFI=n
CONFIG_RTLWIFI=n

# No SCSI tape
CONFIG_CHR_DEV_ST=n

# No parallel ports
CONFIG_PARPORT=n

# No Apple-specific
CONFIG_APPLE_GMUX=n
CONFIG_APPLE_SPI=n

# No Staging drivers
CONFIG_STAGING=n

# No firewire
CONFIG_FIREWIRE=n

# No InfiniBand
CONFIG_INFINIBAND=n

# No NFC
CONFIG_NFC=n

# No 6LoWPAN
CONFIG_6LOWPAN=n

# No UWB
CONFIG_UWB=n
