#!/bin/sh
# k3s-server — single-node k3s control plane + agent.
#
# This service template lives under config/s6/profile-overlays/k8s/ and
# is NOT copied into the rootfs by default. install-services.sh will
# pick it up only when the active profile (config/qos.yaml > profile, or
# /etc/qos/profile at runtime) is `k8s`. See review §2.9.
#
# k3s data lives under /var/lib/rancher/k3s on the state partition;
# factory-reset.sh policy for that path is intentionally TBD.

set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin

state_dir="/var/lib/rancher/k3s"
mkdir -p "$state_dir"

if ! command -v k3s >/dev/null 2>&1; then
    echo "k3s-server: k3s binary not installed; expected on k8s profile only" >&2
    exec sleep 2147483647
fi

# --write-kubeconfig-mode=0644 so non-root operators can talk to the
# cluster via `k9s` without sudo. Tighten later if multi-tenant.
exec k3s server \
    --data-dir "$state_dir" \
    --write-kubeconfig-mode=0644 \
    ${K3S_EXTRA_ARGS:-}
