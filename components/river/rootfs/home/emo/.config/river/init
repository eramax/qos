#!/bin/sh
export XDG_RUNTIME_DIR=/run/user/1000

# Wait for river's Wayland socket to be ready before running riverctl
_n=0
while [ "$_n" -lt 20 ]; do
  riverctl list-outputs 2>/dev/null && break
  sleep 0.2
  _n=$((_n + 1))
done

for output in Virtual-1 HDMI-1 DP-1; do
  if riverctl output "$output" mode 1920x1080@60 2>/dev/null; then
    riverctl output "$output" position 0 0
    break
  fi
done

riverctl keyboard-layout -options "" us

# Set dark theme colors
riverctl border-color-focused 0x5294e2
riverctl border-color-unfocused 0x2d3250
riverctl border-width 2

# Launch waybar with D-Bus session support
dbus-run-session --dbus-daemon=/usr/bin/dbus-daemon waybar >/dev/null 2>&1 &

riverctl map normal Super Q close
riverctl map normal Super+Shift E exit
riverctl map normal Super Return spawn foot
riverctl map normal Super S spawn foot
riverctl map normal Super C spawn chromium
riverctl map normal Super O spawn /usr/bin/atl-launch /usr/share/atl/apks/gles3jni.apk -l com/android/gles3jni/GLES3JNIActivity
riverctl map normal Super P spawn /usr/bin/atl-launch /usr/share/atl/apks/gd.apk -l org/happysanta/gd/GDActivity

riverctl map normal Super J focus-view next
riverctl map normal Super K focus-view previous
riverctl map normal Super+Shift J swap next
riverctl map normal Super+Shift K swap previous
riverctl map normal Super H focus-column left
riverctl map normal Super L focus-column right
riverctl map normal Super+Shift H move left
riverctl map normal Super+Shift L move right

for i in $(seq 1 9); do
  tags=$((1 << ($i - 1)))
  riverctl map normal Super $i set-focused-tags $tags
  riverctl map normal Super+Shift $i set-view-tags $tags
  riverctl map normal Super+Control $i toggle-focused-tags $tags
  riverctl map normal Super+Alt $i toggle-view-tags $tags
done

all_tags=$(((1 << 32) - 1))
riverctl map normal Super 0 set-focused-tags $all_tags
riverctl map normal Super+Shift 0 set-view-tags $all_tags

riverctl map normal Super Period focus-output next
riverctl map normal Super Comma focus-output previous
riverctl map normal Super+Shift Period send-to-output next
riverctl map normal Super+Shift Comma send-to-output previous
riverctl map normal Super+Shift Return zoom
riverctl map normal Super Space toggle-float
riverctl map normal Super F toggle-fullscreen
riverctl map-pointer normal Super BTN_LEFT move-view
riverctl map-pointer normal Super BTN_RIGHT resize-view
riverctl map-pointer normal Super BTN_MIDDLE toggle-float

riverctl default-layout rivertile
rivertile -view-padding 6 -outer-padding 6 &

sleep 0.5
qos-start-vboxclient &

chromium &
