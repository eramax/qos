#!/bin/sh
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin

cloud_local_done="/run/qos/cloud-init-local.done"
cloud_final_done="/run/qos/cloud-init.done"

# Wait for cloud-init to finish so it can render the network config
# from datasources (NoCloud, ConfigDrive, etc).  On VPS providers this
# gives us a static IP; on VirtualBox there is no datasource so we get
# nothing and fall through to DHCP.
if command -v cloud-init >/dev/null 2>&1; then
  wait_count=0
  while [ ! -f "$cloud_final_done" ] && [ "$wait_count" -lt 60 ]; do
    sleep 1
    wait_count=$((wait_count + 1))
  done
fi

# Bring up loopback interface first.
/bin/busybox ip link set lo up

# Find the first non-loopback interface.
iface=""
for candidate in /sys/class/net/*; do
  [ -e "$candidate" ] || continue
  name="${candidate##*/}"
  [ "$name" = lo ] && continue
  case "$name" in
    dummy*|sit*|tun*|virbr*|vnet*) continue ;;
  esac
  iface="$name"
  break
done
[ -n "$iface" ] || { echo "networking: no interface found" >&2; exit 1; }

/bin/busybox ip link set dev "$iface" up

i=0
while [ "$i" -lt 5 ]; do
  carrier=$(cat "/sys/class/net/$iface/carrier" 2>/dev/null || echo 0)
  [ "$carrier" = "1" ] && break
  sleep 1
  i=$((i + 1))
done

echo "networking: $iface link up, carrier=$carrier"

if command -v ifup >/dev/null 2>&1 && [ -f /etc/network/interfaces ]; then
  # ifupdown-ng strictly requires an explicit netmask and fails if only CIDR is provided.
  # cloud-init eni renderer writes CIDR (e.g. address 1.2.3.4/24), so we dynamically patch it.
  awk '
  /^[[:space:]]*address[[:space:]]+[0-9a-fA-F:\.]+\/[0-9]+/ {
      line = $0;
      sub(/\//, " ", line);
      split(line, parts, " ");
      ip = parts[2];
      cidr = parts[3] + 0;
      indent = $0;
      sub(/address.*/, "", indent);
      if (ip ~ /:/) {
          mask = cidr;
      } else {
          mask = "";
          for (i=0; i<4; i++) {
              if (cidr >= 8) { mask = mask "255"; cidr -= 8; }
              else if (cidr > 0) {
                  val = 1; for(j=0; j<8-cidr; j++) val*=2;
                  mask = mask (256 - val); cidr = 0;
              }
              else { mask = mask "0"; }
              if (i < 3) mask = mask ".";
          }
      }
      print indent "address " ip;
      print indent "netmask " mask;
      next;
  }
  { print }
  ' /etc/network/interfaces > /etc/network/interfaces.tmp && mv /etc/network/interfaces.tmp /etc/network/interfaces

  /bin/busybox ip addr flush dev "$iface" 2>/dev/null || true
  /sbin/ifup -a || true
fi

# Ensure the interface is UP before DHCP — ifup may bring it down on error
# (e.g. "unknown method dhcp" with ifupdown-ng).
/bin/busybox ip link set dev "$iface" up 2>/dev/null || true

if ip -4 addr show dev "$iface" | grep -q 'inet '; then
  exec sleep 2147483647
fi

# -T 5: wait 5 s per discover; -t 10: 10 retries before backing off
exec /bin/busybox udhcpc -i "$iface" -f -T 5 -t 10
